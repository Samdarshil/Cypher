# Required when binding the API outside localhost unless CYPHER_PUBLIC_DEMO=true.
# Use a long random secret and enter it in the browser prompt for private access.
CYPHER_ACCESS_TOKEN=

# Set to true only for a public, unauthenticated demo. This disables API token
# authentication and server-local-path evidence ingestion; browser uploads stay capped.
CYPHER_PUBLIC_DEMO=false

# Maximum size for one browser upload (default 20 MiB; maximum 100 MiB).
CYPHER_MAX_UPLOAD_BYTES=20971520
